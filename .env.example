# Administrator account created when the API starts.
ADMIN_NAME=Vantage Admin
ADMIN_EMAIL=admin@vantage.com
ADMIN_PASSWORD=replace-with-a-strong-local-password

# Optional values for host-side Python tools. Export them in your shell or pass
# the equivalent command-line flags; Python does not load this file directly.
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=clickstream-events
KAFKA_CONSUMER_GROUP=clickstream-raw-writer
PRODUCT_API_URL=http://localhost:3000
